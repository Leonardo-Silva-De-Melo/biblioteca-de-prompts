# =============================================================================
# Biblioteca de Prompts — frontend (Vite)
# =============================================================================
# Copie para .env nesta mesma pasta e ajuste conforme o seu ambiente.
#
#   cp .env.example .env
#
# ATENCAO: variaveis VITE_* sao resolvidas em tempo de BUILD e ficam embutidas
# no bundle publicado. NUNCA coloque segredos aqui — qualquer valor definido
# neste arquivo e visivel para quem abrir a aplicacao no navegador.
# =============================================================================

# URL base da API do backend Java/Spring Boot
VITE_API_URL=http://localhost:8080/api

# ---- Keycloak ----
# Endereco pelo qual o NAVEGADOR alcanca o Keycloak. Nao use o nome do servico
# do Docker aqui: o navegador nao resolve nomes da rede interna de containers.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=biblioteca-prompts
VITE_KEYCLOAK_CLIENT_ID=biblioteca-prompts-frontend

# URL do Open WebUI para o Arquiteto Virtual
VITE_OPEN_WEBUI_URL=http://localhost:3000

# Nome exibido como autor nas acoes de favoritar, avaliar e comentar.
# Provisorio, ate a identidade passar a vir do token Keycloak.
VITE_NOME_USUARIO=Usuario Demonstracao

# Ambiente atual: development | homologacao | production
VITE_ENV=development

# Nome exibido na aplicação
VITE_APP_NAME=Biblioteca de Prompts

# Versão do frontend
VITE_APP_VERSION=1.0.0
