# =============================================================================
# BIBLIOTECA DE PROMPTS — variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env` na mesma pasta do docker-compose.yml e preencha
# TODOS os campos marcados como obrigatórios. Nenhum segredo tem valor padrão:
# a stack falha a subida com mensagem explícita se algo estiver em branco.
#
#   cp .env.example .env
#
# O `.env` nunca deve ser versionado — já está coberto pelo .gitignore.
#
# Para gerar valores aleatórios:
#
#   Linux / macOS:   openssl rand -base64 32
#   Windows (PS):    [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# =============================================================================


# -----------------------------------------------------------------------------
# BANCO DE DADOS (obrigatório)
# -----------------------------------------------------------------------------
# A senha abaixo é usada por quatro serviços ao mesmo tempo (postgres, keycloak,
# backend e open-webui). O Compose a distribui a partir desta única variável,
# então basta definir aqui.
#
# Se o banco JÁ EXISTE com outra senha, não basta trocar este valor: é preciso
# alterar a senha no próprio PostgreSQL (ALTER USER) ou recriar o volume.
POSTGRES_DB=bibliotecapromptsdb
POSTGRES_USER=biblioteca_prompts
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# KEYCLOAK — identidade e SSO (obrigatório)
# -----------------------------------------------------------------------------
# Credenciais do administrador do Keycloak, usadas para acessar o console em
# KEYCLOAK_PUBLIC_URL. Escolha uma senha forte: este usuário controla todos os
# acessos da plataforma.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# URL pelo qual o NAVEGADOR alcança o Keycloak. Em instalação local, deixe como
# está. Em servidor, troque pelo endereço real (ex.: https://sso.suainstituicao.br)
# — os tokens são emitidos com este endereço como issuer, e divergência aqui
# derruba o login com erro de "invalid issuer".
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Segredo do client "open-webui" no realm do Keycloak.
# O realm em keycloak-config/ importa este valor por placeholder, então basta
# gerar um segredo próprio antes da primeira subida (ver comandos no topo).
# O mesmo valor é entregue ao container do Keycloak e ao do Open WebUI.
#
# Se o realm JÁ foi importado, mudar aqui não basta — o segredo passou a viver no
# banco do Keycloak. Ajuste também em Clients -> open-webui -> Credentials.
# Detalhes em keycloak-config/README.md.
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# MOTOR DE INFERÊNCIA — Ollama (obrigatório)
# -----------------------------------------------------------------------------
# Endereço do Ollama que tem os modelos de chat baixados.
#
#   Ollama na própria máquina, stack no Docker:
#       OLLAMA_BASE_URL=http://host.docker.internal:11434
#
#   Ollama em outro servidor da rede (recomendado quando só ele tem GPU):
#       OLLAMA_BASE_URL=http://SEU_SERVIDOR:11434
#       Nesse caso, o Ollama do servidor precisa escutar fora do localhost:
#       defina OLLAMA_HOST=0.0.0.0 no serviço e libere a porta no firewall.
#
#   Ollama como container desta stack (exige GPU NVIDIA na máquina):
#       OLLAMA_BASE_URL=http://biblioteca-prompts-ollama:11434
#       e descomente o serviço `ollama` no docker-compose.yml.
#
# Confirme com: curl http://SEU_ENDERECO:11434/api/tags
OLLAMA_BASE_URL=

# Modelo de chat usado pelo backend. Precisa estar baixado no Ollama apontado
# acima — confira em `ollama list`. Se o nome não existir, as chamadas do
# backend falham em tempo de execução (não na subida).
#
#   ollama pull llama3.2
#
OLLAMA_MODEL=llama3.2:latest


# -----------------------------------------------------------------------------
# OPEN WEBUI — interface de chat (obrigatório)
# -----------------------------------------------------------------------------
# Chave de assinatura das sessões. Gere um valor aleatório (ver comandos no topo
# deste arquivo). Trocar este valor depois invalida todas as sessões ativas.
WEBUI_SECRET_KEY=

# URL pelo qual o navegador alcança o Open WebUI. Em servidor, troque pelo
# endereço real.
OPEN_WEBUI_PUBLIC_URL=http://localhost:3000

# URL pelo qual o navegador alcança o FRONTEND da Biblioteca de Prompts. É para
# onde o Open WebUI manda o usuário quando ele clica em "Sair" — o chat é um
# módulo da plataforma, então sair dele devolve o usuário à plataforma.
# Em servidor, troque pelo endereço real (ex.: https://prompts.suainstituicao.br).
FRONTEND_PUBLIC_URL=http://localhost:3001

# Tag da imagem. "main" é bleeding edge: uma atualização pode mudar o
# comportamento do RAG sem aviso. Em produção, fixe uma versão (ex.: v0.6.15).
OPEN_WEBUI_TAG=main


# -----------------------------------------------------------------------------
# DOCLING — extração documental (sem segredo)
# -----------------------------------------------------------------------------
# O docling-serve converte PDF/DOCX/PPTX/XLSX em Markdown estruturado antes de
# o Open WebUI indexar. Ele sobe sem credencial: a porta é publicada apenas em
# 127.0.0.1 e o acesso dos outros serviços acontece pela rede interna.
#
# Não há variável obrigatória aqui. O docker-compose.yml já define:
#
#   CONTENT_EXTRACTION_ENGINE=docling     liga o Open WebUI ao Docling
#   DOCLING_SERVER_URL=http://docling:5001
#   DOCLING_DO_OCR=false                  acervo atual é PDF nativo (tem texto)
#
# ATENÇÃO (PersistentConfig): essas três são lidas do ambiente só na PRIMEIRA
# subida do Open WebUI. Depois disso passam a viver no banco — para alterar,
# use Admin -> Settings -> Documents na interface. Mudar o .env não tem efeito.
#
# ATENÇÃO (OCR): com DOCLING_DO_OCR=false, um PDF que seja apenas imagem
# (digitalização sem camada de texto) é indexado VAZIO e reportado como
# sucesso — nenhum erro aparece. Se for ingerir documento escaneado, ligue
# DOCLING_DO_OCR=true em Admin -> Settings -> Documents antes de anexar.
#
# Interface própria do Docling, útil para testar uma conversão isolada:
#   http://localhost:5001/ui


# -----------------------------------------------------------------------------
# RAG — recuperação aumentada (opcional)
# -----------------------------------------------------------------------------
# Os valores abaixo já vêm com padrão no docker-compose.yml. Descomente apenas
# se precisar ajustar.
#
# ATENÇÃO: a dimensão do vetor é fixada na PRIMEIRA indexação. Trocar o modelo
# de embedding depois obriga a reindexar todo o acervo.
#
# RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=300
# RAG_TOP_K=8


# -----------------------------------------------------------------------------
# PORTAS NO HOST (opcional)
# -----------------------------------------------------------------------------
# Altere apenas se alguma porta já estiver ocupada na sua máquina.
# A porta 3000 costuma conflitar com outras instalações do Open WebUI.
#
# POSTGRES_PORT=5433
# KEYCLOAK_PORT=8180
# BACKEND_PORT=8080
# FRONTEND_PORT=3001
# OPEN_WEBUI_PORT=3000
# DOCLING_PORT=5001


# -----------------------------------------------------------------------------
# CORS (opcional)
# -----------------------------------------------------------------------------
# Origens autorizadas a chamar a API, separadas por vírgula. Inclua aqui o
# endereço do frontend. Em produção, liste apenas os domínios reais — nunca "*".
#
# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
